			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Dock</string>
			<key>footerText</key>
			<string>Customize the Dock from 1 to 8 icons. Capacity and layout update together so newly enabled slots can be filled without a respring. Choosing fewer icons than the Dock currently holds moves the extras out to the Home Screen.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>defaults</key><string>cz.kolbi.sbtweaker</string>
			<key>key</key><string>dockLayoutEnabled</string>
			<key>label</key><string>Customize Dock Count</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cellClass</key>
			<string>SBTNumberCell</string>
			<key>defaults</key>
			<string>cz.kolbi.sbtweaker</string>
			<key>key</key>
			<string>dockIcons</string>
			<key>label</key>
			<string>Dock Icons</string>
			<key>min</key>
			<integer>1</integer>
			<key>max</key>
			<integer>8</integer>
			<key>default</key>
			<integer>4</integer>
			<key>isInteger</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Icon Layout Backup</string>
			<key>footerText</key><string>When enabled, SBTweaker restores the saved Home Screen and Dock layout after SpringBoard starts. SpringBoard's native icon-state saves automatically refresh the backup while jailbroken.</string>
