			<real>0.01</real>
			<key>max</key>
			<real>1.00</real>
			<key>default</key>
			<real>0.01</real>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Spotlight</string>
			<key>footerText</key>
			<string>Dismisses Spotlight and clears the search field once you open a result, so leaving that app returns you to the Home Screen instead of the search you came from. Without it, iOS keeps Spotlight presented behind the app and remembers the query for eight minutes.</string>
		</dict>
		<dict>
			<key>cell</key>
