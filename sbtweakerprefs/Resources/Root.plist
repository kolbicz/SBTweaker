			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Page Transitions</string>
			<key>footerText</key>
			<string>Speeds up the slide when an app opens a new page — a chat, a post, a settings page — and when you go back. Transition Duration is the longest the slide may take: 0.01 is instant, 1.00 is about stock speed. Swiping back still follows your finger. Changes apply right away, no respring needed.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>cz.kolbi.sbtweaker</string>
			<key>key</key>
			<string>noSlide</string>
			<key>label</key>
			<string>Fast Page Transitions</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cellClass</key>
			<string>SBTNumberCell</string>
			<key>defaults</key>
			<string>cz.kolbi.sbtweaker</string>
			<key>key</key>
			<string>noSlideDuration</string>
			<key>label</key>
			<string>Transition Duration</string>
