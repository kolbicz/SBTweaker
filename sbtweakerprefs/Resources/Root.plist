			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>The master switch disables every SBTweaker feature, including system-wide animation and copy hooks. Changes take effect after a respring.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>cz.kolbi.sbtweaker</string>
